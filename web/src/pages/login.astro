---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Login - Overlayr">
  <div class="login-wrapper">
    <div class="login-card">
      <h1 class="login-title">Welcome Back</h1>
      <p class="login-subtitle">
        Sign in to manage your subscription and activate the desktop app.
      </p>

      <button id="btn-google" class="google-btn">
        <img
          src="https://www.svgrepo.com/show/475656/google-color.svg"
          class="google-icon"
          alt="Google"
          width="24"
          height="24"
        />
        Sign in with Google
      </button>

      <div id="status" class="status-msg hidden">Authenticating...</div>
    </div>
  </div>
</Layout>

<style>
  .login-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    background-color: var(--color-bg);
  }

  .login-card {
    background-color: rgba(31, 41, 55, 0.8);
    padding: 2rem;
    border-radius: 1rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    text-align: center;
    max-width: 28rem;
    width: 100%;
    border: 1px solid var(--glass-border);
  }

  .login-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--color-text-heading);
  }

  .login-subtitle {
    margin-bottom: 2rem;
    color: var(--color-text-muted);
  }

  .google-btn {
    width: 100%;
    background-color: white;
    color: #1a1a1a;
    font-weight: 700;
    padding: 0.75rem 1rem;
    border-radius: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .google-btn:hover {
    background-color: #f3f4f6;
  }

  .google-icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .status-msg {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: #facc15; /* Yellow-400 */
  }

  .status-msg.hidden {
    display: none;
  }

  .text-red-500 {
    color: #ef4444;
  }
</style>

<script>
  import { currentUser, onUser, signInWithGoogle } from "../lib/session";

  const btn = document.getElementById("btn-google");
  const status = document.getElementById("status");
  const params = new URLSearchParams(window.location.search);
  // "desktop" hands the login to the Overlayr app; "web" or a same-site URL
  // returns there; none goes to the profile.
  const callback = params.get("callback");
  let handled = false;

  function showStatus(text: string, error = false) {
    if (!status) return;
    status.innerText = text;
    status.classList.remove("hidden");
    status.classList.toggle("text-red-500", error);
  }

  /** Where a web login goes afterwards, as a site path. */
  function destination() {
    if (!callback) return "/profile";
    if (callback === "web") return "/";
    try {
      const url = new URL(callback, window.location.origin);
      if (url.origin === window.location.origin) return url.pathname + url.search;
    } catch {}
    return "/";
  }

  function openApp(login: { token: string; uid: string; refreshToken: string }) {
    const deepLink =
      `overlayr://auth?token=${encodeURIComponent(login.token)}` +
      `&uid=${encodeURIComponent(login.uid)}` +
      `&refresh=${encodeURIComponent(login.refreshToken)}`;
    showStatus("Opening Overlayr…");
    window.location.href = deepLink;
    setTimeout(() => showStatus("Opened Overlayr? You can close this tab."), 3000);
  }

  // Coming back from Google for the app: the tokens are in the fragment,
  // which never reaches a server. Take them out of the address bar first.
  const fragment = new URLSearchParams(window.location.hash.slice(1));
  if (callback === "desktop" && fragment.get("token")) {
    handled = true;
    history.replaceState(null, "", window.location.pathname + window.location.search);
    openApp({
      token: fragment.get("token")!,
      uid: fragment.get("uid") ?? "",
      refreshToken: fragment.get("refresh") ?? "",
    });
  }
  if (params.get("error")) showStatus(params.get("error")!, true);

  async function continueToApp() {
    const response = await fetch("/api/auth/desktop", {
      method: "POST",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json" },
      body: "{}",
    });
    if (!response.ok) {
      window.location.href = "/api/auth/google?return=desktop";
      return;
    }
    openApp(await response.json());
  }

  onUser((user) => {
    if (!user || handled) return;
    if (callback === "desktop") {
      if (btn) btn.lastChild!.textContent = ` Continue to Overlayr as ${user.displayName || user.email}`;
      return;
    }
    handled = true;
    window.location.href = destination();
  });

  btn?.addEventListener("click", () => {
    if (callback === "desktop") {
      handled = true;
      if (currentUser()) continueToApp();
      else window.location.href = "/api/auth/google?return=desktop";
      return;
    }
    showStatus("Redirecting to Google…");
    signInWithGoogle(destination());
  });
</script>
