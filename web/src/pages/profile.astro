---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Your Profile - Overlayr">
    <div class="profile-section">
        <div class="container">
            <div class="profile-card">
                <div class="header">
                    <img
                        id="avatar"
                        src="https://www.svgrepo.com/show/446533/avatar.svg"
                        alt="Profile"
                        class="avatar"
                        width="80"
                        height="80"
                    />
                    <div class="user-info">
                        <h1 id="user-name" class="name">Loading...</h1>
                        <p id="user-email" class="email">...</p>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- Selling packs -->
                <section id="creator" class="creator">
                    <div class="section-header">
                        <h2>Sell translation packs</h2>
                        <span id="payout-badge" class="status-badge hidden"></span>
                    </div>
                    <p id="creator-intro" class="muted">
                        Set your packs' prices when you publish them in
                        Overlayr. You receive <strong id="creator-share">65%</strong>
                        of every sale, paid to your bank account by Stripe.
                        Payouts are available to creators in Thailand.
                    </p>

                    <div id="creator-stats" class="stats hidden">
                        <div class="stat">
                            <span class="stat-value" id="stat-sales">0</span>
                            <span class="stat-label">Sales</span>
                        </div>
                        <div class="stat">
                            <span class="stat-value" id="stat-earned">฿0</span>
                            <span class="stat-label">Your earnings</span>
                        </div>
                    </div>

                    <div id="connect-banner" class="connect-slot"></div>
                    <div id="connect-main" class="connect-slot"></div>
                    <p id="creator-error" class="error hidden"></p>

                    <div class="actions">
                        <button id="btn-setup" class="btn btn-primary hidden">Set up payouts</button>
                        <button id="btn-update" class="btn btn-secondary hidden">Update payout details</button>
                    </div>
                </section>

                <div class="divider"></div>

                <button id="btn-logout" class="btn btn-logout">Log out</button>
            </div>
        </div>
    </div>
</Layout>

<style>
    .profile-section {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        position: relative;
        z-index: 1;
    }

    .container {
        width: 100%;
        max-width: 640px;
    }

    .profile-card {
        background-color: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 1.5rem;
        padding: 2.5rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.06);
        color: #1a1a1a;
    }

    @media (max-width: 480px) {
        .profile-card {
            padding: 1.5rem;
        }
    }

    .header {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .avatar {
        border-radius: 50%;
        border: 3px solid #ec4899;
        object-fit: cover;
        background-color: #f3f4f6;
        padding: 3px;
        box-sizing: border-box;
        flex-shrink: 0;
    }

    .name {
        font-size: 1.75rem;
        font-weight: 700;
        color: #111;
        margin: 0;
        overflow-wrap: anywhere;
    }

    .email {
        color: #555;
        margin: 0;
        overflow-wrap: anywhere;
    }

    .divider {
        height: 1px;
        background-color: #eee;
        margin-block: 2rem;
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.75rem;
    }

    .section-header h2 {
        font-size: 1.25rem;
        margin: 0;
        color: #111;
    }

    .muted {
        color: #555;
        line-height: 1.6;
        margin: 0;
    }

    .status-badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    .status-badge.active {
        background-color: #ecfdf5;
        color: #059669;
    }

    .status-badge.pending {
        background-color: #fffbeb;
        color: #d97706;
    }

    .stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        margin-top: 1.25rem;
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 1rem;
        border-radius: 1rem;
        background: #fafafa;
        border: 1px solid #f0f0f0;
    }

    .stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #111;
        font-variant-numeric: tabular-nums;
    }

    .stat-label {
        font-size: 0.8rem;
        color: #6b7280;
    }

    .connect-slot:not(:empty) {
        margin-top: 1.25rem;
    }

    .error {
        color: #dc2626;
        margin: 1rem 0 0;
    }

    .actions {
        display: flex;
        gap: 0.5rem;
        margin-top: 1.25rem;
        flex-wrap: wrap;
    }

    .actions:not(:has(.btn:not(.hidden))) {
        display: none;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.6rem 1rem;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.825rem;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        border: none;
        white-space: nowrap;
    }

    .btn:disabled {
        opacity: 0.6;
        cursor: progress;
    }

    .btn-primary {
        flex: 1;
        background: linear-gradient(135deg, #ec4899, #8b5cf6);
        color: white;
    }

    .btn-primary:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(236, 72, 153, 0.3);
    }

    .btn-secondary,
    .btn-logout {
        background-color: #f3f4f6;
        color: #374151;
        border: 1px solid #e5e7eb;
    }

    .btn-secondary {
        flex: 1;
    }

    .btn-logout {
        width: 100%;
    }

    .btn-secondary:hover:not(:disabled),
    .btn-logout:hover {
        background-color: #e5e7eb;
    }

    .hidden {
        display: none !important;
    }
</style>

<script>
    import { loadConnectAndInitialize, type StripeConnectInstance } from "@stripe/connect-js";
    import { onUser, postAsUser, signOutUser } from "../lib/session";

    type CreatorStatus = {
        connected: boolean;
        payoutsEnabled: boolean;
        commission: number;
        sales: number;
        earned: number;
    };

    const $ = (id: string) => document.getElementById(id)!;
    const baht = (satang: number) =>
        (satang / 100).toLocaleString("th-TH", { style: "currency", currency: "THB" });

    let connect: StripeConnectInstance | null = null;

    function showError(text: string) {
        $("creator-error").textContent = text;
        $("creator-error").classList.remove("hidden");
    }

    async function loadStatus(): Promise<CreatorStatus | null> {
        const response = await fetch("/api/creator/status", { credentials: "same-origin" });
        if (!response.ok) {
            showError("Could not load your creator account. Reload the page to try again.");
            return null;
        }
        return response.json();
    }

    /** Stripe's embedded components, signed in as the creator's account. */
    async function connectInstance(): Promise<StripeConnectInstance> {
        if (connect) return connect;
        const first = await postAsUser("/api/creator/session");
        const body = await first.json();
        if (!first.ok || !body.publishableKey) throw new Error(body.error || "Payouts are not available yet");
        let firstSecret: string | null = body.clientSecret;
        connect = loadConnectAndInitialize({
            publishableKey: body.publishableKey,
            // The first secret is already here; later ones (after it
            // expires) come from a new session.
            fetchClientSecret: async () => {
                if (firstSecret) {
                    const secret = firstSecret;
                    firstSecret = null;
                    return secret;
                }
                const response = await postAsUser("/api/creator/session");
                return (await response.json()).clientSecret;
            },
            appearance: { variables: { colorPrimary: "#ec4899", fontFamily: "inherit" } },
        });
        return connect;
    }

    async function render(status: CreatorStatus) {
        $("creator-share").textContent = `${Math.round((1 - status.commission) * 100)}%`;
        const badge = $("payout-badge");
        badge.classList.toggle("hidden", !status.connected);
        badge.classList.toggle("active", status.payoutsEnabled);
        badge.classList.toggle("pending", !status.payoutsEnabled);
        badge.textContent = status.payoutsEnabled ? "Payouts on" : "Setup unfinished";

        $("creator-stats").classList.toggle("hidden", !status.connected);
        $("stat-sales").textContent = String(status.sales);
        $("stat-earned").textContent = baht(status.earned);
        $("btn-setup").classList.toggle("hidden", status.payoutsEnabled);
        $("btn-setup").textContent = status.connected ? "Continue payout setup" : "Set up payouts";
        $("btn-update").classList.toggle("hidden", !status.payoutsEnabled);

        if (status.payoutsEnabled) await showPayouts();
    }

    async function showPayouts() {
        const instance = await connectInstance();
        $("connect-banner").replaceChildren(instance.create("notification-banner"));
        $("connect-main").replaceChildren(instance.create("payouts"));
    }

    /** Goes to Stripe's page to set up or update the account; it comes back here. */
    async function openStripeSetup(button?: HTMLButtonElement) {
        if (button) button.disabled = true;
        const response = await postAsUser("/api/creator/onboard");
        const body = await response.json().catch(() => ({}));
        if (response.ok && body.url) {
            window.location.href = body.url;
            return;
        }
        showError(body.error || "Could not open payout setup");
        if (button) button.disabled = false;
    }

    $("btn-setup").addEventListener("click", () => openStripeSetup($("btn-setup") as HTMLButtonElement));
    $("btn-update").addEventListener("click", () => openStripeSetup($("btn-update") as HTMLButtonElement));

    $("btn-logout").addEventListener("click", async () => {
        await signOutUser();
        window.location.href = "/";
    });

    onUser(async (user) => {
        if (!user) {
            window.location.href = `/login?callback=${encodeURIComponent("/profile")}`;
            return;
        }
        $("user-name").textContent = user.displayName || "Overlayr user";
        $("user-email").textContent = user.email || "";
        if (user.photoURL) (document.getElementById("avatar") as HTMLImageElement).src = user.photoURL;
        // Stripe sends the creator back with ?setup=retry when its link
        // expired: get a fresh one.
        const setup = new URLSearchParams(window.location.search).get("setup");
        history.replaceState(null, "", "/profile");
        if (setup === "retry") {
            await openStripeSetup();
            return;
        }
        try {
            const status = await loadStatus();
            if (status) await render(status);
        } catch (error) {
            showError(error instanceof Error ? error.message : String(error));
        }
    });
</script>
