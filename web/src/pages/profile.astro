---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Your Profile - Overlayr">
    <div class="profile-section">
        <div class="container">
            <div class="profile-card">
                <div class="header">
                    <img
                        id="avatar"
                        src="https://www.svgrepo.com/show/446533/avatar.svg"
                        alt="Profile"
                        class="avatar"
                        width="80"
                        height="80"
                    />
                    <div class="user-info">
                        <h1 id="user-name" class="name">Loading...</h1>
                        <p id="user-email" class="email">...</p>
                    </div>
                </div>

                <div class="divider"></div>

                <div class="subscription-status">
                    <h2>Subscription Status</h2>
                    <div id="loading-spinner" class="spinner"></div>

                    <div id="plan-details" class="details hidden">
                        <div class="status-row">
                            <span class="label">Current Plan:</span>
                            <span id="plan-name" class="value badge"
                                >Checking...</span
                            >
                        </div>
                        <div class="status-row">
                            <span class="label">Status:</span>
                            <span id="sub-status" class="value">Active</span>
                        </div>
                        <div class="status-row">
                            <span class="label">Expires:</span>
                            <span id="expiry-date" class="value">-</span>
                        </div>
                    </div>

                    <div
                        id="features-container"
                        class="features-section hidden"
                    >
                        <h3>Included Features</h3>
                        <ul id="features-list" class="features-list">
                            <!-- Features populated via JS -->
                        </ul>
                    </div>

                    <div id="no-plan" class="details hidden">
                        <p>
                            You are currently on the <strong>Free Tier</strong>.
                        </p>
                        <a href="/#pricing" class="upgrade-btn"
                            >Upgrade to Pro</a
                        >
                    </div>
                </div>

                <div class="actions">
                    <button id="btn-logout" class="logout-btn">Sign Out</button>
                    <button id="btn-manage" class="manage-btn hidden"
                        >Manage Subscription</button
                    >
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .profile-section {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        /* Revert to default/transparent so global noise and orbs show through */
        position: relative;
        z-index: 1;
    }

    .container {
        width: 100%;
        max-width: 600px;
    }

    .profile-card {
        background-color: #ffffff; /* White Card */
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 1.5rem;
        padding: 2.5rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
        color: #1a1a1a; /* Force dark text for contrast on white */
    }

    .header {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .avatar {
        border-radius: 50%;
        border: 3px solid #ec4899; /* Pink-500 */
        object-fit: cover;
        background-color: #f3f4f6;
    }

    .name {
        font-size: 1.75rem;
        font-weight: 700;
        color: #111;
        margin: 0;
    }

    .email {
        color: #555;
        margin: 0;
    }

    .divider {
        height: 1px;
        background-color: #eee;
        margin-block: 2rem;
    }

    .subscription-status h2 {
        font-size: 1.25rem;
        margin-bottom: 1.5rem;
        color: #111;
    }

    .logout-btn {
        background-color: #f3f4f6;
        color: #374151;
        border: 1px solid #e5e7eb;
    }

    .logout-btn:hover {
        background-color: #e5e7eb;
    }

    .manage-btn {
        background-color: #111827; /* Dark Gray / Black */
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        border: none;
        flex: 1;
    }

    .manage-btn:hover {
        background-color: #000;
        transform: translateY(-1px);
    }

    .features-section {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #f3f4f6;
    }

    .features-section h3 {
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6b7280;
        margin-bottom: 1rem;
    }

    .features-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
    }

    .features-list li {
        font-size: 0.875rem;
        color: #374151;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .features-list li::before {
        content: "✓";
        color: #10b981;
        font-weight: bold;
    }

    .status-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-block: 0.75rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .status-row:last-child {
        border-bottom: none;
    }

    .label {
        color: #666; /* Muted text for white bg */
    }

    .value {
        font-weight: 600;
        color: #000; /* Dark text for white bg */
    }

    .badge {
        background-color: rgba(236, 72, 153, 0.1);
        color: #f472b6;
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
        font-size: 0.875rem;
    }

    .actions {
        margin-top: 2.5rem;
        display: flex;
        gap: 1rem;
    }

    .logout-btn,
    .upgrade-btn {
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
        border: none;
    }

    .logout-btn {
        background-color: #f3f4f6;
        color: #374151;
        border: 1px solid #e5e7eb;
    }

    .logout-btn:hover {
        background-color: #e5e7eb;
    }

    .upgrade-btn {
        background: linear-gradient(to right, #ec4899, #8b5cf6);
        color: white;
        text-align: center;
    }

    .upgrade-btn:hover {
        transform: scale(1.05);
    }

    .hidden {
        display: none;
    }

    .spinner {
        width: 30px;
        height: 30px;
        border: 3px solid rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        border-top-color: #ec4899;
        animation: spin 1s ease-in-out infinite;
        margin: 0 auto;
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<script>
    import { auth, db } from "../lib/firebase";
    import { onAuthStateChanged, signOut } from "firebase/auth";
    import { doc, getDoc } from "firebase/firestore";

    const els = {
        name: document.getElementById("user-name"),
        email: document.getElementById("user-email"),
        avatar: document.getElementById("avatar") as HTMLImageElement,
        spinner: document.getElementById("loading-spinner"),
        planDetails: document.getElementById("plan-details"),
        noPlan: document.getElementById("no-plan"),
        planName: document.getElementById("plan-name"),
        expiry: document.getElementById("expiry-date"),
        logoutBtn: document.getElementById("btn-logout"),
        manageBtn: document.getElementById("btn-manage"),
        featuresContainer: document.getElementById("features-container"),
        featuresList: document.getElementById("features-list"),
    };

    const FEATURE_LABELS: Record<string, string> = {
        advanced_ocr: "Advanced OCR Engine",
        priority_support: "Priority Support",
        premium_ai: "Premium AI Models",
        no_watermark: "No Watermark",
        unlimited_translations: "Unlimited Translations",
        zero_latency: "Zero Latency Mode",
    };

    onAuthStateChanged(auth, async (user) => {
        if (!user) {
            window.location.href = "/login?callback=web";
            return;
        }

        // 1. Show Basic Info
        if (els.name) els.name.innerText = user.displayName || "User";
        if (els.email) els.email.innerText = user.email || "";
        if (els.avatar && user.photoURL) {
            let url = user.photoURL;
            if (url.includes("googleusercontent.com")) {
                // Ensure high-resolution square crop for Google images
                // Using a safer regex that replaces existing sizing or appends it
                url = url.replace(/=s\d+(-c)?$/, "") + "=s384-c";
                els.avatar.referrerPolicy = "no-referrer";
            }
            els.avatar.src = url;
            els.avatar.onerror = () => {
                const fallback = `https://ui-avatars.com/api/?name=${encodeURIComponent(user.email || "User")}&background=random`;
                if (els.avatar.src !== fallback) {
                    els.avatar.src = fallback;
                    els.avatar.referrerPolicy = "no-referrer";
                }
            };
        }

        // 2. Fetch Firestore Data
        try {
            const docRef = doc(db, "users", user.uid);
            const docSnap = await getDoc(docRef);

            if (els.spinner) els.spinner.classList.add("hidden");

            if (docSnap.exists()) {
                const data = docSnap.data();
                const isPro = data.isPro || false;

                if (isPro) {
                    if (els.planDetails)
                        els.planDetails.classList.remove("hidden");
                    if (els.planName)
                        els.planName.innerText = (
                            data.plan || "Pro"
                        ).toUpperCase();

                    if (data.expiryDate && els.expiry) {
                        const date = new Date(data.expiryDate);
                        els.expiry.innerText = date.toLocaleDateString();
                    }

                    // 3. Show Features
                    const features = data.features || [];
                    if (
                        features.length > 0 &&
                        els.featuresList &&
                        els.featuresContainer
                    ) {
                        els.featuresList.innerHTML = features
                            .map(
                                (f: string) =>
                                    `<li>${FEATURE_LABELS[f] || f}</li>`,
                            )
                            .join("");
                        els.featuresContainer.classList.remove("hidden");
                    }

                    // 4. Show Manage Button
                    if (data.stripeCustomerId && els.manageBtn) {
                        els.manageBtn.classList.remove("hidden");
                        els.manageBtn.onclick = async () => {
                            if (els.manageBtn)
                                els.manageBtn.innerText = "Opening...";
                            try {
                                const res = await fetch(
                                    "/api/create-portal-session",
                                    {
                                        method: "POST",
                                        body: JSON.stringify({
                                            customerId: data.stripeCustomerId,
                                        }),
                                    },
                                );
                                const { url } = await res.json();
                                window.location.href = url;
                            } catch (e) {
                                console.error("Portal error:", e);
                                if (els.manageBtn)
                                    els.manageBtn.innerText =
                                        "Error opening portal";
                            }
                        };
                    }
                } else {
                    if (els.noPlan) els.noPlan.classList.remove("hidden");
                    if (els.featuresContainer)
                        els.featuresContainer.classList.add("hidden");
                }
            } else {
                // No doc = Free Tier
                if (els.noPlan) els.noPlan.classList.remove("hidden");
            }
        } catch (e) {
            console.error("Error fetching profile:", e);
            if (els.spinner) els.spinner.classList.add("hidden");
        }
    });

    els.logoutBtn?.addEventListener("click", () => {
        signOut(auth).then(() => (window.location.href = "/"));
    });
</script>
