---
import { getRelativeLocaleUrl } from "astro:i18n";
import LanguageSelector from "../components/LanguageSelector.astro";
import { getLangFromUrl, useTranslations } from "../i18n/ui";
import "../styles/global.css";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeUrl = getRelativeLocaleUrl(lang, "");

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Overlayr translates dialogue, quests, and game UI in a live Windows overlay—and remembers the words you teach it.",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#070908" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="keywords"
            content="game translator, live game translation, OCR overlay, Windows translator, Japanese game translation, game subtitles"
        />
        <meta name="author" content="Overlayr Team" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL("/og.png", Astro.site)} />
        <meta
            property="og:image:alt"
            content="Overlayr translating a Japanese game dialogue in a live Windows overlay"
        />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={new URL("/og.png", Astro.site)} />

        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "SoftwareApplication",
                name: "Overlayr",
                operatingSystem: "Windows 10, Windows 11",
                applicationCategory: "GameApplication",
                offers: {
                    "@type": "Offer",
                    price: "0",
                    priceCurrency: "THB",
                },
                description,
            })}
        />
    </head>
    <body>
        <a class="skip-link" href="#main-content">Skip to content</a>
        <header class="site-header">
            <div class="container header-inner">
                <a class="brand" href={homeUrl} aria-label="Overlayr home">
                    <span class="brand-mark" aria-hidden="true">O</span>
                    <span>Overlayr</span>
                </a>

                <nav class="desktop-nav" aria-label="Primary navigation">
                    <a href={`${homeUrl}#features`}>Features</a>
                    <a href={`${homeUrl}#how-it-works`}>How it works</a>
                    <a href={`${homeUrl}#pricing`}>Pricing</a>
                    <a href={`${homeUrl}#faq`}>FAQ</a>
                </nav>

                <div class="header-actions">
                    <LanguageSelector />
                    <a class="header-download" href="/#download">
                        {t("hero.cta")}
                    </a>
                </div>
            </div>
        </header>

        <main id="main-content">
            <slot />
        </main>

        <footer class="site-footer">
            <div class="container footer-grid">
                <div>
                    <a class="brand footer-brand" href={homeUrl}>
                        <span class="brand-mark" aria-hidden="true">O</span>
                        <span>Overlayr</span>
                    </a>
                    <p class="footer-note">
                        Understand the game. Stay in the moment.
                    </p>
                </div>
                <div class="footer-links">
                    <a href={getRelativeLocaleUrl(lang, "privacy")}>
                        {t("footer.privacy")}
                    </a>
                    <a href={getRelativeLocaleUrl(lang, "terms")}>
                        {t("footer.terms")}
                    </a>
                    <a href={getRelativeLocaleUrl(lang, "contact")}>Contact</a>
                    <a href="/login?callback=web">Sign in</a>
                </div>
            </div>
            <div class="container footer-bottom">
                <span>© {new Date().getFullYear()} Overlayr</span>
                <span>Built for players, not pop-ups.</span>
            </div>
        </footer>
    </body>
</html>

<style>
    .skip-link {
        position: fixed;
        z-index: 100;
        top: 1rem;
        left: 1rem;
        padding: 0.75rem 1rem;
        color: #0d1008;
        background: var(--color-primary);
        transform: translateY(-180%);
    }

    .skip-link:focus {
        transform: translateY(0);
    }

    .site-header {
        position: sticky;
        z-index: 50;
        top: 0;
        height: var(--header-height);
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        background: rgba(7, 9, 8, 0.78);
        backdrop-filter: blur(20px);
    }

    .header-inner {
        display: flex;
        height: 100%;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        font-family: var(--font-heading);
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: -0.04em;
    }

    .brand-mark {
        display: grid;
        width: 2rem;
        height: 2rem;
        place-items: center;
        border-radius: 0.55rem;
        color: #101409;
        background: var(--color-primary);
        font-size: 0.8rem;
        font-weight: 800;
    }

    .desktop-nav {
        display: flex;
        align-items: center;
        gap: clamp(1rem, 2.5vw, 2rem);
        color: var(--color-text-muted);
        font-size: 0.9rem;
        font-weight: 600;
    }

    .desktop-nav a,
    .footer-links a {
        transition: color 160ms ease;
    }

    .desktop-nav a:hover,
    .footer-links a:hover {
        color: var(--color-primary);
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 0.7rem;
    }

    .header-download {
        padding: 0.7rem 1rem;
        border-radius: 0.65rem;
        color: #101409;
        background: var(--color-primary);
        font-size: 0.86rem;
        font-weight: 700;
    }

    .site-footer {
        position: relative;
        padding: 4rem 0 2rem;
        border-top: 1px solid var(--color-border);
        background: #090b09;
    }

    .footer-grid,
    .footer-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
    }

    .footer-brand {
        margin-bottom: 1rem;
    }

    .footer-note {
        font-size: 0.95rem;
    }

    .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        color: var(--color-text-muted);
        font-size: 0.88rem;
    }

    .footer-bottom {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
        color: #747b71;
        font-size: 0.78rem;
    }

    @media (max-width: 900px) {
        .desktop-nav {
            display: none;
        }
    }

    @media (max-width: 620px) {
        .header-download {
            display: none;
        }

        .footer-grid,
        .footer-bottom {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>
