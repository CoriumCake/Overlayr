---
import { STRIPE_LINKS } from "../siteConfig";

type Lang = "en" | "ja" | "es" | "th";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

const copyByLang: Record<Lang, {
    eyebrow: string;
    title: string;
    subtitle: string;
    freePeriod: string;
    proPeriod: string;
    freeCta: string;
    proCta: string;
}> = {
    en: {
        eyebrow: "Simple pricing",
        title: "Start free. Upgrade when Overlayr becomes part of your game.",
        subtitle: "No feature maze and no annual commitment during early access.",
        freePeriod: "during beta",
        proPeriod: "/ month",
        freeCta: "Download free",
        proCta: "Join early access",
    },
    th: {
        eyebrow: "ราคาที่เข้าใจง่าย",
        title: "เริ่มฟรี อัปเกรดเมื่อ Overlayr กลายเป็นส่วนหนึ่งของการเล่น",
        subtitle: "ไม่มีแพ็กเกจซับซ้อน และไม่ผูกมัดรายปีในช่วง Early Access",
        freePeriod: "ตลอดช่วงเบต้า",
        proPeriod: "/ เดือน",
        freeCta: "ดาวน์โหลดฟรี",
        proCta: "เข้าร่วม Early Access",
    },
    ja: {
        eyebrow: "シンプルな料金",
        title: "無料で始めて、必要になったときだけアップグレード。",
        subtitle: "早期アクセス期間は複雑なプランも年間契約もありません。",
        freePeriod: "ベータ期間中",
        proPeriod: "/ 月",
        freeCta: "無料ダウンロード",
        proCta: "早期アクセスに参加",
    },
    es: {
        eyebrow: "Precios sencillos",
        title: "Empieza gratis. Mejora cuando Overlayr sea parte de tu juego.",
        subtitle: "Sin planes confusos ni compromiso anual durante el acceso anticipado.",
        freePeriod: "durante la beta",
        proPeriod: "/ mes",
        freeCta: "Descargar gratis",
        proCta: "Unirme al acceso anticipado",
    },
};

const copy = copyByLang[lang];

const tiers = [
    {
        id: "free",
        name: "Free",
        price: "฿0",
        period: copy.freePeriod,
        description: "Everything you need to start translating a game.",
        features: [
            "Live OCR translation overlay",
            "Manual and real-time capture",
            "Local game profiles",
            "Save preferred translations",
        ],
    },
    {
        id: "pro",
        name: "Pro Early Access",
        price: "฿249",
        period: copy.proPeriod,
        description: "For players building a long-term translation library.",
        features: [
            "Unlimited saved game corrections",
            "Priority game-profile requests",
            "Early context-translation features",
            "Founder community access",
        ],
    },
];
---

<section id="pricing" class="pricing-section">
    <div class="container">
        <div class="pricing-intro">
            <span class="eyebrow">{copy.eyebrow}</span>
            <h2 class="section-heading">{copy.title}</h2>
            <p class="section-lede">{copy.subtitle}</p>
        </div>

        <div class="pricing-grid">
            {tiers.map((tier) => (
                <article class:list={["pricing-card", { featured: tier.id === "pro" }]}>
                    <div class="tier-topline">
                        <h3>{tier.name}</h3>
                        {tier.id === "pro" && <span>Founding plan</span>}
                    </div>
                    <p class="tier-description">{tier.description}</p>
                    <div class="price">
                        <strong>{tier.price}</strong>
                        <span>{tier.period}</span>
                    </div>
                    <ul>
                        {tier.features.map((feature) => (
                            <li><i aria-hidden="true">✓</i>{feature}</li>
                        ))}
                    </ul>

                    {tier.id === "free" ? (
                        <a class="price-button free-button" href="#download">
                            {copy.freeCta}
                        </a>
                    ) : STRIPE_LINKS.pro ? (
                        <a class="price-button pro-button" data-tier-id="pro">
                            {copy.proCta}
                        </a>
                    ) : (
                        <a class="price-button pro-button" href="/contact">
                            {copy.proCta}
                        </a>
                    )}
                </article>
            ))}
        </div>

        <p class="pricing-note">
            Early access pricing is in Thai baht. Cancel anytime. Your local game profiles remain yours.
        </p>
    </div>
</section>

<style>
    .pricing-section {
        padding-block: var(--space-xl);
        border-top: 1px solid var(--color-border);
    }

    .pricing-intro {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(280px, 0.45fr);
        column-gap: 4rem;
        align-items: end;
    }

    .pricing-intro .eyebrow,
    .pricing-intro .section-heading {
        grid-column: 1;
    }

    .pricing-intro .section-lede {
        grid-column: 2;
        grid-row: 1 / span 2;
        margin-top: 0;
    }

    .pricing-grid {
        display: grid;
        max-width: 940px;
        margin: clamp(3rem, 7vw, 5rem) auto 0;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .pricing-card {
        display: flex;
        min-height: 570px;
        padding: clamp(1.5rem, 3vw, 2.4rem);
        border: 1px solid var(--color-border);
        border-radius: 1.2rem;
        flex-direction: column;
        background: #111411;
    }

    .pricing-card.featured {
        border-color: var(--color-border-strong);
        background:
            radial-gradient(circle at 100% 0, rgba(217, 255, 99, 0.09), transparent 42%),
            #141812;
        box-shadow: 0 26px 80px rgba(0, 0, 0, 0.28);
    }

    .tier-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .tier-topline h3 {
        font-size: 1.35rem;
    }

    .tier-topline span {
        padding: 0.3rem 0.55rem;
        border-radius: 999px;
        color: #111509;
        background: var(--color-primary);
        font-size: 0.62rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .tier-description {
        min-height: 3.2rem;
        margin-top: 1rem;
        font-size: 0.9rem;
    }

    .price {
        display: flex;
        margin: 2.2rem 0;
        align-items: baseline;
        gap: 0.6rem;
    }

    .price strong {
        color: #fff;
        font-family: var(--font-heading);
        font-size: clamp(2.8rem, 5vw, 4.2rem);
        letter-spacing: -0.06em;
        line-height: 1;
    }

    .price span {
        color: #858c81;
        font-size: 0.85rem;
    }

    .pricing-card ul {
        display: grid;
        margin-bottom: 2rem;
        gap: 0.9rem;
        color: #bac0b6;
        font-size: 0.88rem;
        list-style: none;
    }

    .pricing-card li {
        display: flex;
        align-items: flex-start;
        gap: 0.65rem;
    }

    .pricing-card li i {
        color: var(--color-primary);
        font-style: normal;
    }

    .price-button {
        display: flex;
        min-height: 52px;
        margin-top: auto;
        border: 1px solid var(--color-border);
        border-radius: 0.7rem;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        transition:
            transform 160ms ease,
            background 160ms ease;
    }

    .price-button:hover {
        transform: translateY(-2px);
    }

    .free-button {
        background: rgba(255, 255, 255, 0.04);
    }

    .free-button:hover {
        background: rgba(255, 255, 255, 0.08);
    }

    .pro-button {
        border-color: var(--color-primary);
        color: #111509;
        background: var(--color-primary);
    }

    .pro-button:hover {
        background: #e4ff8c;
    }

    .pricing-note {
        margin-top: 1.5rem;
        text-align: center;
        font-size: 0.76rem;
    }

    @media (max-width: 820px) {
        .pricing-intro {
            display: block;
        }

        .pricing-intro .section-lede {
            margin-top: 1.5rem;
        }
    }

    @media (max-width: 680px) {
        .pricing-grid {
            grid-template-columns: 1fr;
        }

        .pricing-card {
            min-height: 520px;
        }
    }
</style>

<script>
    import { onAuthStateChanged } from "firebase/auth";
    import { auth } from "../lib/firebase";

    onAuthStateChanged(auth, (user) => {
        const buttons = document.querySelectorAll<HTMLAnchorElement>(
            ".price-button[data-tier-id]",
        );

        buttons.forEach((button) => {
            if (user) {
                button.href = `/checkout?plan=${button.dataset.tierId}`;
                return;
            }

            button.href = "/login?callback=web";
        });
    });
</script>
