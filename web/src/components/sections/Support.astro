---
import { useTranslations } from "../../i18n/ui";
import type { Lang } from "../../i18n/ui";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="support" class="support-section">
    <div class="container">
        <h1>{t("support.title")}</h1>
        <p class="subtitle">{t("support.subtitle")}</p>

        <details class="glass-panel faq-item">
            <summary>{t("support.faq1.q")}</summary>
            <p>{t("support.faq1.a")}</p>
        </details>

        <details class="glass-panel faq-item">
            <summary>{t("support.faq2.q")}</summary>
            <p>{t("support.faq2.a")}</p>
        </details>

        <details class="glass-panel faq-item">
            <summary>{t("support.faq3.q")}</summary>
            <p>{t("support.faq3.a")}</p>
        </details>

        <details class="glass-panel faq-item">
            <summary>{t("support.faq4.q")}</summary>
            <p>{t("support.faq4.a")}</p>
        </details>
    </div>
</section>

<style>
    .support-section {
        padding-block: var(--space-xl);
    }

    h1 {
        text-align: center;
        margin-bottom: var(--space-md);
        font-size: var(--text-h2);
    }

    .subtitle {
        text-align: center;
        color: var(--color-text-muted);
        margin-bottom: var(--space-lg);
        font-size: var(--text-h3);
    }

    .faq-grid {
        max-width: 820px;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }

    .faq-item {
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        border-radius: 1.25rem;
        box-shadow: var(--glass-shadow);
        padding: 0;
        overflow: hidden;
        margin-bottom: 1rem;
    }

    summary {
        padding: 1.1rem 1.5rem;
        cursor: pointer;
        font-weight: 600;
        font-size: 1rem;
        color: var(--color-text-main);
        background: transparent;
        transition: background 0.2s;
        border-bottom: 1px solid transparent;
        list-style: none;
        position: relative;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary::after {
        content: "+";
        position: absolute;
        right: 1.5rem;
        font-weight: 300;
        font-size: 1.5rem;
        line-height: 1;
        transition: transform 0.3s;
        color: var(--color-text-muted);
    }

    details[open] summary::after {
        transform: rotate(45deg);
    }

    details[open] summary {
        background: var(--glass-bg-hover);
        border-bottom: 1px solid var(--glass-border);
    }

    summary:hover {
        background: var(--glass-bg);
    }

    .faq-item p {
        padding: 1.1rem 1.5rem;
        color: var(--color-text-muted);
        line-height: 1.6;
    }
</style>
