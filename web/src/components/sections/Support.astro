---
import { useTranslations } from "../../i18n/ui";

interface Props {
    lang: "en" | "ja" | "es";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="support" class="support-section">
    <div class="container">
        <h1>{t("support.title")}</h1>
        <p class="subtitle">{t("support.subtitle")}</p>

        <details class="glass-panel faq-item">
            <summary>{t("support.faq1.q")}</summary>
            <p>{t("support.faq1.a")}</p>
        </details>

        <details class="glass-panel faq-item">
            <summary>{t("support.faq2.q")}</summary>
            <p>{t("support.faq2.a")}</p>
        </details>

        <details class="glass-panel faq-item">
            <summary>{t("support.faq3.q")}</summary>
            <p>{t("support.faq3.a")}</p>
        </details>

        <details class="glass-panel faq-item">
            <summary>{t("support.faq4.q")}</summary>
            <p>{t("support.faq4.a")}</p>
        </details>
    </div>
</section>

<style>
    .support-section {
        padding-block: var(--space-xl);
    }

    h1 {
        text-align: center;
        margin-bottom: var(--space-md);
        font-size: var(--text-h1);
    }

    .subtitle {
        text-align: center;
        color: var(--color-text-muted);
        margin-bottom: var(--space-xl);
        font-size: var(--text-h3);
    }

    .faq-grid {
        max-width: 1000px;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }

    .faq-item {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 1rem;
        box-shadow:
            0 20px 40px -10px rgba(0, 0, 0, 0.1),
            0 0 20px rgba(255, 255, 255, 0.2);
        padding: 0;
        overflow: hidden;
        margin-bottom: 1rem;
    }

    summary {
        padding: var(--space-md) var(--space-lg);
        cursor: pointer;
        font-weight: 600;
        font-size: 1.125rem;
        color: #1a1a1a; /* Force dark text */
        background: transparent;
        transition: background 0.2s;
        border-bottom: 1px solid transparent;
        list-style: none;
        position: relative;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary::after {
        content: "+";
        position: absolute;
        right: var(--space-lg);
        font-weight: 300;
        font-size: 1.5rem;
        line-height: 1;
        transition: transform 0.3s;
        color: #1a1a1a;
    }

    details[open] summary::after {
        transform: rotate(45deg);
    }

    details[open] summary {
        background: rgba(0, 0, 0, 0.05);
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }

    summary:hover {
        background: rgba(0, 0, 0, 0.02);
    }

    .faq-item p {
        padding: var(--space-md) var(--space-lg);
        color: #333; /* Force dark muted text */
        line-height: 1.6;
    }
</style>
