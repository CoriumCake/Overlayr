---
import { useTranslations } from "../../i18n/ui";

type Lang = "en" | "ja" | "es" | "th";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const questions = [1, 2, 3, 4] as const;
---

<section id="faq" class="faq-section">
    <div class="container faq-grid">
        <div class="faq-intro">
            <span class="eyebrow">Questions, answered</span>
            <h2 class="section-heading">{t("support.title")}</h2>
            <p class="section-lede">{t("support.subtitle")}</p>
            <a href="/contact">Still curious? Talk to us →</a>
        </div>

        <div class="faq-list">
            {questions.map((number) => (
                <details>
                    <summary>
                        <span>{t(`support.faq${number}.q`)}</span>
                        <i aria-hidden="true">+</i>
                    </summary>
                    <p>{t(`support.faq${number}.a`)}</p>
                </details>
            ))}
        </div>
    </div>
</section>

<style>
    .faq-section {
        padding-block: var(--space-xl);
        border-top: 1px solid var(--color-border);
        background: #0a0d0a;
    }

    .faq-grid {
        display: grid;
        grid-template-columns: minmax(280px, 0.7fr) 1fr;
        gap: clamp(3rem, 8vw, 8rem);
    }

    .faq-intro {
        align-self: start;
        position: sticky;
        top: calc(var(--header-height) + 3rem);
    }

    .faq-intro a {
        display: inline-block;
        margin-top: 2rem;
        color: var(--color-primary);
        font-size: 0.9rem;
        font-weight: 700;
    }

    .faq-list {
        border-top: 1px solid var(--color-border);
    }

    details {
        border-bottom: 1px solid var(--color-border);
    }

    summary {
        display: flex;
        padding: 1.5rem 0;
        align-items: flex-start;
        justify-content: space-between;
        gap: 2rem;
        color: #e9ece6;
        cursor: pointer;
        font-family: var(--font-heading);
        font-size: 1.05rem;
        font-weight: 600;
        list-style: none;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary i {
        color: var(--color-primary);
        font-size: 1.35rem;
        font-style: normal;
        font-weight: 400;
        line-height: 1;
        transition: transform 160ms ease;
    }

    details[open] summary i {
        transform: rotate(45deg);
    }

    details p {
        max-width: 680px;
        padding: 0 3rem 1.5rem 0;
        font-size: 0.92rem;
    }

    @media (max-width: 800px) {
        .faq-grid {
            grid-template-columns: 1fr;
        }

        .faq-intro {
            position: static;
        }
    }
</style>
