---
import { useTranslations } from "../i18n/ui";

interface Props {
    lang?: "en" | "ja" | "es";
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const features = [
    {
        title: t("feature.latency.title"),
        description: t("feature.latency.desc"),
        icon: "⚡",
    },
    {
        title: t("feature.support.title"),
        description: t("feature.support.desc"),
        icon: "🎮",
    },
    {
        title: t("feature.live.title"),
        description: t("feature.live.desc"),
        icon: "🌐",
    },
    // Add more translations for others if needed, using generic keys for now
];
---

<section class="features">
    <div class="container">
        <h2 class="section-title">{t("section.why")}</h2>
        <div class="grid">
            {
                features.map((feature) => (
                    <div class="glass-panel feature-card">
                        <div class="icon-wrapper">{feature.icon}</div>
                        <h3>{feature.title}</h3>
                        <p>{feature.description}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .features {
        padding-block: var(--space-xl);
    }

    .section-title {
        text-align: center;
        font-size: var(--text-h2);
        margin-bottom: var(--space-xl);
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: var(--space-lg);
    }

    .feature-card {
        padding: var(--space-lg);
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 1rem;
        box-shadow:
            0 20px 40px -10px rgba(0, 0, 0, 0.1),
            0 0 20px rgba(255, 255, 255, 0.2);
        transition:
            transform 0.3s ease,
            background 0.3s ease,
            border-color 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        border-color: var(--color-primary);
    }

    .icon-wrapper {
        font-size: 2.5rem;
        margin-bottom: var(--space-md);
        background: rgba(0, 0, 0, 0.05); /* Light grey background for icon */
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        border: 1px solid rgba(0, 0, 0, 0.1);
    }

    h3 {
        font-size: var(--text-h3);
        margin-bottom: var(--space-sm);
        color: #1a1a1a; /* Force dark text */
    }

    p {
        color: #666; /* Force dark muted text */
        font-size: var(--text-body);
    }
</style>
