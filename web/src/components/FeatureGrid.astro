---
import { useTranslations } from "../i18n/ui";
import type { Lang } from "../i18n/ui";

interface Props {
    lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const features = [
    {
        title: t("feature.latency.title"),
        description: t("feature.latency.desc"),
        icon: "⚡",
    },
    {
        title: t("feature.support.title"),
        description: t("feature.support.desc"),
        icon: "🎮",
    },
    {
        title: t("feature.live.title"),
        description: t("feature.live.desc"),
        icon: "🌐",
    },
    // Add more translations for others if needed, using generic keys for now
];
---

<section class="features" id="features">
    <div class="container">
        <h2 class="section-title">{t("section.why")}</h2>
        <div class="grid">
            {
                features.map((feature) => (
                    <div class="glass-panel feature-card">
                        <div class="icon-wrapper">{feature.icon}</div>
                        <h3>{feature.title}</h3>
                        <p>{feature.description}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .features {
        padding-block: var(--space-xl);
        scroll-margin-top: 2rem;
    }

    .section-title {
        text-align: center;
        font-size: var(--text-h2);
        margin-bottom: var(--space-lg);
        color: var(--color-title);
        text-shadow: var(--title-glow);
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
        gap: 1.25rem;
    }

    .feature-card {
        padding: 1.75rem 1.5rem;
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        border-radius: 1.25rem;
        box-shadow: var(--glass-shadow);
        transition: transform 0.3s ease, border-color 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        border-color: var(--color-primary);
    }

    .icon-wrapper {
        font-size: 1.4rem;
        margin-bottom: 1rem;
        background: var(--glass-bg-hover);
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        border: 1px solid var(--glass-border);
    }

    h3 {
        font-size: 1.15rem;
        margin-bottom: 0.5rem;
        color: var(--color-text-main);
    }

    p {
        color: var(--color-text-muted);
        font-size: 0.925rem;
        line-height: 1.6;
    }
</style>
