---

<button id="theme-toggle" aria-label="Toggle theme">
    <svg
        class="sun-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>
    <svg
        class="moon-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
</button>

<style>
    #theme-toggle {
        background: transparent;
        border: 1px solid var(--glass-border);
        border-radius: 50%;
        cursor: pointer;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text-main);
        transition:
            background 0.2s,
            transform 0.2s;
        overflow: hidden;
        position: relative;
    }

    #theme-toggle:hover {
        background: var(--glass-bg-hover);
    }

    /* Icon visibility logic based on theme */
    .sun-icon,
    .moon-icon {
        position: absolute;
        transition:
            transform 0.5s cubic-bezier(0.23, 1, 0.32, 1),
            opacity 0.5s;
    }

    /* Default (Dark Mode): Show Moon, Hide Sun */
    :global([data-theme="light"]) .moon-icon {
        transform: translateY(40px) rotate(45deg);
        opacity: 0;
    }

    :global([data-theme="light"]) .sun-icon {
        transform: translateY(0) rotate(0);
        opacity: 1;
    }

    /* Dark Mode State */
    :global(:not([data-theme="light"])) .sun-icon {
        transform: translateY(-40px) rotate(-45deg);
        opacity: 0;
    }

    :global(:not([data-theme="light"])) .moon-icon {
        transform: translateY(0) rotate(0);
        opacity: 1;
    }
</style>

<script is:inline>
    const handleToggleClick = () => {
        const element = document.documentElement;
        element.classList.add("theme-transition");

        // Check current state
        const isLight = element.getAttribute("data-theme") === "light";
        const nextTheme = isLight ? "dark" : "light";

        // Update DOM
        if (nextTheme === "light") {
            element.setAttribute("data-theme", "light");
        } else {
            element.removeAttribute("data-theme");
        }

        // Save preference
        localStorage.setItem("theme", nextTheme);

        // Remove transition class after animation
        setTimeout(() => {
            element.classList.remove("theme-transition");
        }, 500);
    };

    document
        .getElementById("theme-toggle")
        ?.addEventListener("click", handleToggleClick);
</script>
