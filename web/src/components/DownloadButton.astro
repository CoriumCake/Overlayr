---
// Force Vercel rebuild
import { GITHUB_LATEST_RELEASE } from "../siteConfig";

interface Props {
    href?: string;
    version: string;
    checksum: string;
}

const { href = GITHUB_LATEST_RELEASE, version, checksum } = Astro.props;
---

<div class="download-wrapper">
    <div class="glow-effect"></div>
    <a href={href} class="download-btn">
        <span class="btn-content">
            <span class="label">Download Overlayr</span>
        </span>
        <span class="icon">
            <svg
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
                ></path><polyline points="7 10 12 15 17 10"></polyline><line
                    x1="12"
                    y1="15"
                    x2="12"
                    y2="3"></line></svg
            >
        </span>
    </a>
</div>

<style>
    .download-wrapper {
        position: relative;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        z-index: 10;
    }

    .glow-effect {
        position: absolute;
        inset: -5px;
        background: linear-gradient(
            45deg,
            var(--color-primary),
            var(--color-accent)
        );
        filter: blur(20px);
        opacity: 0.6;
        animation: pulse-glow 3s infinite;
        z-index: -1;
        border-radius: 999px;
    }

    .download-btn {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1.25rem 2.5rem;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 999px;
        color: #1a1a1a;
        box-shadow:
            0 8px 32px 0 rgba(0, 0, 0, 0.1),
            0 0 20px rgba(255, 255, 255, 0.4);
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 800;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        position: relative;
    }

    .download-btn::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(255, 255, 255, 0.2),
            transparent
        );
        transform: translateX(-100%);
        transition: transform 0.5s;
    }

    .download-btn:hover {
        transform: translateY(-2px) scale(1.02);
        background: rgba(255, 255, 255, 0.2);
        box-shadow: 0 10px 40px -10px var(--color-primary);
    }

    .download-btn:hover::before {
        transform: translateX(100%);
    }

    .btn-content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        line-height: 1;
    }

    .label {
        font-size: 1.25rem;
    }

    .version {
        font-size: 0.75rem;
        opacity: 0.8;
        font-weight: 600;
        margin-top: 4px;
    }
</style>
