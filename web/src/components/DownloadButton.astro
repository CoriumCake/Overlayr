---
import { GITHUB_LATEST_RELEASE } from "../siteConfig";

interface Props {
    href?: string;
    version?: string;
    checksum?: string;
    label?: string;
}

const {
    href = GITHUB_LATEST_RELEASE,
    label = "Download Overlayr",
} = Astro.props;
---

<a href={href} class="button button-primary download-button">
    <span>{label}</span>
    <span class="arrow" aria-hidden="true">↓</span>
</a>

<style>
    .download-button {
        min-width: 200px;
    }

    .arrow {
        font-size: 1.15rem;
        transition: transform 160ms ease;
    }

    .download-button:hover .arrow {
        transform: translateY(2px);
    }
</style>
