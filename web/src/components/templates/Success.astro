---
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n/ui";

interface Props {
    lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as any);
---

<Layout title={`${t("success.title")} - Overlayr`}>
    <div class="success-container">
        <div class="success-card">
            <div class="icon-wrapper">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="64"
                    height="64"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="check-icon"
                >
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </div>
            <h1>{t("success.title")}</h1>
            <p id="status-message" class="message">
                {t("success.message")}
            </p>

            <div id="loading-spinner" class="spinner"></div>

            <div id="manual-action" class="manual-action hidden">
                <p class="sub-message">
                    {t("success.received")}
                </p>
                <a href="/profile" class="btn-primary">{t("success.profile")}</a
                >
            </div>
        </div>
    </div>
</Layout>

<style>
    .success-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .success-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 1.5rem;
        padding: 3rem 2rem;
        box-shadow:
            0 20px 40px -10px rgba(0, 0, 0, 0.1),
            0 0 20px rgba(255, 255, 255, 0.2);
        text-align: center;
        max-width: 500px;
        width: 100%;
    }

    .icon-wrapper {
        display: inline-flex;
        padding: 1rem;
        border-radius: 50%;
        background-color: rgba(16, 185, 129, 0.1);
        color: #10b981;
        margin-bottom: 1.5rem;
    }

    h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 1rem;
    }

    .message {
        color: #4b5563;
        font-size: 1.1rem;
        margin-bottom: 2rem;
    }

    .sub-message {
        color: #6b7280;
        font-size: 0.95rem;
        margin-bottom: 1.5rem;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid rgba(236, 72, 153, 0.1);
        border-radius: 50%;
        border-top-color: #ec4899;
        animation: spin 1s ease-in-out infinite;
        margin: 0 auto;
    }

    .manual-action {
        margin-top: 2rem;
        animation: fadeIn 0.5s ease-out;
    }

    .btn-primary {
        display: inline-block;
        padding: 0.75rem 2rem;
        background: linear-gradient(to right, #ec4899, #8b5cf6);
        color: white;
        text-decoration: none;
        border-radius: 0.5rem;
        font-weight: 600;
        transition: transform 0.2s;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
    }

    .hidden {
        display: none;
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    import { auth, db } from "../../lib/firebase";
    import { onAuthStateChanged } from "firebase/auth";
    import { doc, onSnapshot } from "firebase/firestore";

    const els = {
        spinner: document.getElementById("loading-spinner"),
        manualAction: document.getElementById("manual-action"),
        statusMessage: document.getElementById("status-message"),
    };

    let unsubscribeFirestore: (() => void) | null = null;
    let redirectTimeout: number | null = null;

    // Show manual button after 6 seconds if not redirected
    redirectTimeout = window.setTimeout(() => {
        if (els.manualAction) els.manualAction.classList.remove("hidden");
        if (els.spinner) els.spinner.classList.add("hidden");
        if (els.statusMessage) {
            els.statusMessage.textContent = "Payment received!";
        }
    }, 6000);

    onAuthStateChanged(auth, (user) => {
        if (!user) {
            console.log("No user found, waiting for manual navigation.");
            return;
        }

        // Listen for real-time updates to the user document
        unsubscribeFirestore = onSnapshot(doc(db, "users", user.uid), (doc) => {
            if (doc.exists()) {
                const data = doc.data();
                if (data?.isPro) {
                    console.log("User is Pro! Redirecting...");
                    if (redirectTimeout) clearTimeout(redirectTimeout);
                    window.location.href = "/profile";
                }
            }
        });
    });

    // Cleanup logic if user navigates away
    window.addEventListener("beforeunload", () => {
        if (unsubscribeFirestore) unsubscribeFirestore();
        if (redirectTimeout) clearTimeout(redirectTimeout);
    });
</script>
