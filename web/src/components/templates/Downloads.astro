---
import Layout from "../../layouts/Layout.astro";
import { SITE } from "../../siteConfig";
import { useTranslations } from "../../i18n/ui";

interface Props {
    lang: "en" | "ja" | "es" | "th";
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Each platform's installer is served from /download/<platform>. The
// version, notes and file sizes come from /api/releases/latest.
const platforms = [
    { id: "windows", name: "Windows", detail: t("downloads.windows") },
    { id: "macos", name: "macOS", detail: t("downloads.macos") },
    { id: "appimage", name: "Linux", detail: t("downloads.linux") },
];
---

<Layout title={`${t("downloads.title")} - ${SITE.title}`}>
    <section class="downloads-page">
        <div class="container">
            <h1>{t("downloads.title")}</h1>
            <p class="subtitle">{t("downloads.subtitle")}</p>

            <div class="releases-list">
                <article class="glass-panel release-card latest">
                    <div class="release-header">
                        <div class="version-info">
                            <h2 id="release-version">…</h2>
                            <span id="release-date" class="release-date"></span>
                            <span id="release-badge" class="badge hidden">{t("downloads.latest")}</span>
                        </div>
                    </div>
                    <p id="release-status" class="status">{t("downloads.loading")}</p>

                    <div class="platforms">
                        {
                            platforms.map((platform) => (
                                <div class="platform" data-platform={platform.id}>
                                    <div class="platform-text">
                                        <h3>{platform.name}</h3>
                                        <p>{platform.detail}</p>
                                        <p class="platform-file" />
                                    </div>
                                    <a class="platform-button disabled" href={`/download/${platform.id}`}>
                                        {t("downloads.download")}
                                    </a>
                                </div>
                            ))
                        }
                    </div>

                    <div id="release-changes" class="changes hidden">
                        <h3>{t("downloads.changes")}</h3>
                        <ul id="release-notes"></ul>
                    </div>
                </article>
            </div>
        </div>
    </section>
</Layout>

<script define:vars={{ released: t("downloads.released"), none: t("downloads.none"), unavailable: t("downloads.unavailable") }}>
    const megabytes = (bytes) => `${(bytes / 1024 / 1024).toFixed(1)} MB`;
    const status = document.getElementById("release-status");

    fetch("/api/releases/latest")
        .then((response) => (response.ok ? response.json() : { release: null }))
        .catch(() => ({ release: null }))
        .then(({ release }) => {
            if (!release) {
                status.textContent = none;
                return;
            }
            status.remove();
            document.getElementById("release-version").textContent = `v${release.version}`;
            document.getElementById("release-date").textContent = `${released} ${release.date}`;
            document.getElementById("release-badge").classList.remove("hidden");
            for (const row of document.querySelectorAll(".platform")) {
                const file = row.dataset.platform === "appimage"
                    ? (release.files.appimage ?? release.files.linux)
                    : release.files[row.dataset.platform];
                const button = row.querySelector(".platform-button");
                const label = row.querySelector(".platform-file");
                if (file) {
                    button.classList.remove("disabled");
                    label.textContent = `${file.name} · ${megabytes(file.size)} · SHA-256 ${file.sha256.slice(0, 16)}…`;
                    label.title = file.sha256;
                } else {
                    label.textContent = unavailable;
                }
            }
            const notes = document.getElementById("release-notes");
            for (const note of release.notes ?? []) {
                const item = document.createElement("li");
                item.textContent = note;
                notes.append(item);
            }
            if (notes.children.length) document.getElementById("release-changes").classList.remove("hidden");
        });
</script>

<style>
    .downloads-page {
        padding-top: calc(var(--header-height) + var(--space-lg));
        padding-bottom: var(--space-xl);
    }

    h1 {
        text-align: center;
        font-size: var(--text-h1);
        margin-bottom: var(--space-sm);
    }

    .subtitle {
        text-align: center;
        color: var(--color-text-muted);
        margin-bottom: var(--space-xl);
        font-size: var(--text-h3);
    }

    .releases-list {
        display: flex;
        flex-direction: column;
        gap: var(--space-lg);
        max-width: 800px;
        margin-inline: auto;
    }

    .release-card {
        padding: var(--space-lg);
        position: relative;
        overflow: hidden;
    }

    .release-card.latest {
        border-color: var(--color-primary);
        box-shadow: 0 0 30px rgba(var(--color-primary-rgb), 0.1);
    }

    .release-card.latest::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: var(--color-primary);
    }

    .release-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-md);
        margin-bottom: var(--space-lg);
        padding-bottom: var(--space-md);
        border-bottom: 1px solid var(--glass-border);
    }

    .version-info {
        display: flex;
        align-items: baseline;
        gap: var(--space-md);
    }

    .version-info h2 {
        font-size: 2rem;
        margin: 0;
        line-height: 1;
    }

    .release-date {
        color: var(--color-text-muted);
        font-size: 0.9rem;
    }

    .badge {
        background: var(--color-primary);
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 99px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .changes h3 {
        font-size: 1.1rem;
        margin-bottom: var(--space-sm);
        color: var(--color-text-main);
    }

    .changes ul {
        list-style: disc;
        padding-left: 1.5rem;
        color: var(--color-text-muted);
    }

    .changes li {
        margin-bottom: 0.5rem;
    }

    .status {
        color: var(--color-text-muted);
        margin-bottom: var(--space-md);
    }

    .platforms {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        margin-bottom: var(--space-lg);
    }

    .platform {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-md);
        flex-wrap: wrap;
        padding: var(--space-md);
        border: 1px solid var(--glass-border);
        border-radius: 12px;
    }

    .platform-text {
        flex: 1 1 260px;
        min-width: 0;
    }

    .platform-text h3 {
        margin: 0 0 0.25rem;
        font-size: 1.15rem;
    }

    .platform-text p {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 0.9rem;
        overflow-wrap: anywhere;
    }

    .platform-file {
        margin-top: 0.25rem !important;
        font-size: 0.8rem !important;
        font-variant-numeric: tabular-nums;
    }

    .platform-button {
        padding: 0.6rem 1.4rem;
        border-radius: 999px;
        background: linear-gradient(45deg, var(--color-primary), var(--color-accent));
        color: white;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }

    .platform-button.disabled {
        opacity: 0.4;
        pointer-events: none;
    }

    .hidden {
        display: none !important;
    }
</style>
