---
import Layout from "../../layouts/Layout.astro";
import { SITE } from "../../siteConfig";
import { useTranslations } from "../../i18n/ui";
import type { Lang } from "../../i18n/ui";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const faqs = [
    ["support.faq1.q", "support.faq1.a"],
    ["support.faq2.q", "support.faq2.a"],
    ["support.faq3.q", "support.faq3.a"],
    ["support.faq4.q", "support.faq4.a"],
] as const;
---

<Layout title={`${t("support.title")} - ${SITE.title}`}>
    <section class="support-page">
        <div class="container">
            <h1>{t("support.title")}</h1>
            <p class="subtitle">{t("support.subtitle")}</p>

            <div class="faq-grid">
                {
                    faqs.map(([q, a]) => (
                        <details class="glass-panel faq-item">
                            <summary>{t(q)}</summary>
                            <p>{t(a)}</p>
                        </details>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>

<style>
    .support-page {
        padding-top: calc(var(--header-height) + var(--space-lg));
        padding-bottom: var(--space-xl);
    }

    h1 {
        text-align: center;
        margin-bottom: var(--space-md);
        font-size: var(--text-h2);
    }

    .subtitle {
        text-align: center;
        color: var(--color-text-muted);
        margin-bottom: var(--space-lg);
        font-size: var(--text-h3);
    }

    .faq-grid {
        max-width: 800px;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }

    .faq-item {
        padding: 0;
        overflow: hidden;
    }

    summary {
        padding: 1.1rem 1.5rem;
        cursor: pointer;
        font-weight: 600;
        font-size: 1.125rem;
        background: rgba(255, 255, 255, 0.03);
        transition: background 0.2s;
        border-bottom: 1px solid transparent;
        list-style: none; /* Hide default triangle */
        position: relative;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary::after {
        content: "+";
        position: absolute;
        right: 1.5rem;
        font-weight: 300;
        font-size: 1.5rem;
        line-height: 1;
        transition: transform 0.3s;
    }

    details[open] summary::after {
        transform: rotate(45deg);
    }

    details[open] summary {
        background: var(--glass-bg-hover);
        border-bottom: 1px solid var(--glass-border);
    }

    summary:hover {
        background: var(--glass-bg-hover);
    }

    .faq-item p {
        padding: 1.1rem 1.5rem;
        color: var(--color-text-muted);
        line-height: 1.6;
    }
</style>
