---
import { languages } from "../i18n/ui";
import { getRelativeLocaleUrl } from "astro:i18n";

const currentLang = Astro.currentLocale || "en";
const currentPath =
    Astro.url.pathname.replace(new RegExp(`^/${currentLang}`), "") || "/";

const label = languages[currentLang as keyof typeof languages] || "Language";
---

<div class="lang-dropdown" id="lang-dropdown">
    <button
        class="lang-btn"
        id="lang-btn"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label="Select Language"
    >
        <span class="current-lang">{label}</span>
        <svg
            class="chevron"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="m6 9 6 6 6-6"></path>
        </svg>
    </button>

    <div class="lang-menu" id="lang-menu">
        {
            Object.entries(languages).map(([lang, label]) => (
                <a
                    href={getRelativeLocaleUrl(lang, currentPath)}
                    class:list={["menu-item", { active: currentLang === lang }]}
                >
                    {label}
                    {currentLang === lang && (
                        <svg
                            class="check"
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                    )}
                </a>
            ))
        }
    </div>
</div>

<style>
    .lang-dropdown {
        position: relative;
        z-index: 50;
    }

    .lang-btn {
        appearance: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 999px; /* Pill shape */
        color: #1a1a1a;
        font-family: var(--font-body);
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow:
            0 4px 12px -2px rgba(0, 0, 0, 0.1),
            0 0 15px rgba(255, 255, 255, 0.2);
    }

    .lang-btn:hover,
    .lang-btn[aria-expanded="true"] {
        transform: translateY(-1px);
        box-shadow:
            0 6px 16px -4px rgba(0, 0, 0, 0.15),
            0 0 20px rgba(255, 255, 255, 0.4);
        border-color: rgba(255, 255, 255, 0.8);
    }

    .chevron {
        opacity: 0.6;
        transition: transform 0.2s;
    }

    .lang-btn[aria-expanded="true"] .chevron {
        transform: rotate(180deg);
    }

    /* Dropdown Menu */
    .lang-menu {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 160px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 1rem;
        padding: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        box-shadow:
            0 10px 40px -10px rgba(0, 0, 0, 0.2),
            0 0 30px rgba(255, 255, 255, 0.15);
        opacity: 0;
        transform: translateY(-10px);
        pointer-events: none;
        transition:
            opacity 0.2s,
            transform 0.2s;
        z-index: 1000; /* Ensure high z-index */
    }

    .lang-menu.show {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    .menu-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.625rem 1rem;
        color: #1a1a1a;
        text-decoration: none;
        border-radius: 0.5rem;
        font-size: 0.9rem;
        font-weight: 500;
        transition: background 0.2s;
        white-space: nowrap;
    }

    .menu-item:hover {
        background: rgba(0, 0, 0, 0.05);
        color: var(--color-primary);
    }

    .menu-item.active {
        /* Use hsla logic since rgb var is missing */
        background: hsla(var(--hue-primary), 100%, 50%, 0.1);
        color: var(--color-primary);
        font-weight: 700;
    }

    .check {
        color: var(--color-primary);
        margin-left: 0.5rem;
    }
</style>

<script>
    const btn = document.getElementById("lang-btn");
    const menu = document.getElementById("lang-menu");
    const container = document.getElementById("lang-dropdown");

    function toggleMenu() {
        const isExpanded = btn?.getAttribute("aria-expanded") === "true";
        btn?.setAttribute("aria-expanded", String(!isExpanded));
        menu?.classList.toggle("show");
    }

    function closeMenu() {
        btn?.setAttribute("aria-expanded", "false");
        menu?.classList.remove("show");
    }

    btn?.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleMenu();
    });

    // Close on click outside
    document.addEventListener("click", (e) => {
        if (container && !container.contains(e.target as Node)) {
            closeMenu();
        }
    });

    // Close on escape
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeMenu();
    });
</script>
