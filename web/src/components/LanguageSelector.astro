---
import { getRelativeLocaleUrl } from "astro:i18n";
import { languages } from "../i18n/ui";

const currentLang = Astro.currentLocale || "en";
const currentPath =
    Astro.url.pathname.replace(new RegExp(`^/${currentLang}`), "") || "/";
const label = languages[currentLang as keyof typeof languages] || "Language";
---

<div class="lang-dropdown" id="lang-dropdown">
    <button
        class="lang-button"
        id="lang-button"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label="Select language"
    >
        <span>{label}</span>
        <i aria-hidden="true">⌄</i>
    </button>

    <div class="lang-menu" id="lang-menu" role="menu">
        {Object.entries(languages).map(([lang, languageLabel]) => (
            <a
                href={getRelativeLocaleUrl(lang, currentPath)}
                class:list={["lang-option", { active: currentLang === lang }]}
                role="menuitem"
            >
                <span>{languageLabel}</span>
                {currentLang === lang && <i aria-hidden="true">•</i>}
            </a>
        ))}
    </div>
</div>

<style>
    .lang-dropdown {
        position: relative;
        z-index: 60;
    }

    .lang-button {
        display: flex;
        min-height: 38px;
        padding: 0.55rem 0.75rem;
        border: 1px solid var(--color-border);
        border-radius: 0.65rem;
        align-items: center;
        gap: 0.45rem;
        color: #bdc3b9;
        background: rgba(255, 255, 255, 0.035);
        cursor: pointer;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .lang-button:hover,
    .lang-button[aria-expanded="true"] {
        border-color: rgba(255, 255, 255, 0.24);
        color: #fff;
    }

    .lang-button i {
        color: var(--color-primary);
        font-size: 0.9rem;
        font-style: normal;
        transition: transform 160ms ease;
    }

    .lang-button[aria-expanded="true"] i {
        transform: rotate(180deg);
    }

    .lang-menu {
        position: absolute;
        top: calc(100% + 0.55rem);
        right: 0;
        display: grid;
        min-width: 170px;
        padding: 0.45rem;
        border: 1px solid var(--color-border);
        border-radius: 0.8rem;
        gap: 0.15rem;
        visibility: hidden;
        opacity: 0;
        background: rgba(13, 16, 13, 0.97);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
        transform: translateY(-6px);
        transition:
            opacity 140ms ease,
            transform 140ms ease,
            visibility 140ms ease;
        backdrop-filter: blur(20px);
    }

    .lang-menu.show {
        visibility: visible;
        opacity: 1;
        transform: translateY(0);
    }

    .lang-option {
        display: flex;
        padding: 0.65rem 0.7rem;
        border-radius: 0.45rem;
        align-items: center;
        justify-content: space-between;
        color: #9fa69c;
        font-size: 0.8rem;
    }

    .lang-option:hover,
    .lang-option.active {
        color: #fff;
        background: rgba(255, 255, 255, 0.055);
    }

    .lang-option i {
        color: var(--color-primary);
        font-style: normal;
    }

    @media (max-width: 520px) {
        .lang-button span {
            display: none;
        }

        .lang-button {
            width: 38px;
            justify-content: center;
        }
    }
</style>

<script>
    const button = document.getElementById("lang-button");
    const menu = document.getElementById("lang-menu");
    const container = document.getElementById("lang-dropdown");

    const closeMenu = () => {
        button?.setAttribute("aria-expanded", "false");
        menu?.classList.remove("show");
    };

    button?.addEventListener("click", (event) => {
        event.stopPropagation();
        const isOpen = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", String(!isOpen));
        menu?.classList.toggle("show", !isOpen);
    });

    document.addEventListener("click", (event) => {
        if (container && !container.contains(event.target as Node)) {
            closeMenu();
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeMenu();
    });
</script>
